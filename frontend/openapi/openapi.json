            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PageResponseAgencyResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "agencies"
        ],
        "summary": "Cadastra um órgão",
        "operationId": "createAgency",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgencyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AgencyResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/options": {
      "get": {
        "tags": [
          "users"
        ],
        "summary": "Usuários ativos, para escolher responsável",
        "operationId": "listUserOptions",
