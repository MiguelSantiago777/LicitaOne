                    "$ref": "#/components/schemas/TenderEventResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tenders/summary": {
      "get": {
        "tags": [
          "tenders"
        ],
        "summary": "Quantidade e valor por situação (segue os mesmos filtros da lista)",
        "operationId": "tenderSummary",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "agencyId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "city",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "materialType",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "minValue",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "maxValue",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "ownerId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/StatusTotalResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tenders/suggestions": {
      "get": {
        "tags": [
          "tenders"
        ],
        "summary": "Tipos de material e portais já usados, para autocompletar",
        "operationId": "tenderSuggestions",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/SuggestionsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "tags": [
          "users"
        ],
        "summary": "Usuário logado",
        "operationId": "getCurrentUser",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UpdateUser": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 0
          },
          "role": {
            "type": "string",
            "enum": [
              "ADMIN",
              "SALES",
              "VIEWER"
            ]
          },
          "active": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "role"
        ]
      },
      "UserResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "ADMIN",
              "SALES",
              "VIEWER"
            ]
          },
          "roleLabel": {
            "type": "string"
          },
          "initials": {
            "type": "string"
          },
          "active": {
            "type": "boolean"
          },
          "lastLoginAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "active",
          "email",
          "id",
          "initials",
          "lastLoginAt",
          "name",
          "role",
          "roleLabel",
          "version"
        ]
      },
      "TenderRequest": {
        "type": "object",
        "properties": {
          "agencyId": {
            "type": "string",
            "format": "uuid"
          },
          "modality": {
            "type": "string",
            "enum": [
              "PREGAO_ELETRONICO",
              "PREGAO_PRESENCIAL",
              "DISPENSA",
              "CONCORRENCIA",
              "OUTRA"
            ]
          },
          "uasg": {
            "type": "string",
            "maxLength": 10,
            "minLength": 0
          },
          "processNumber": {
            "type": "string",
            "maxLength": 30,
            "minLength": 0
          },
          "portal": {
            "type": "string",
            "maxLength": 80,
            "minLength": 0
          },
          "sessionAt": {
            "type": "string",
            "format": "date-time"
          },
          "object": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 0
          },
          "materialType": {
            "type": "string",
            "maxLength": 120,
            "minLength": 0
          },
          "itemsQuantity": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "totalValue": {
            "type": "number",
            "minimum": 0
          },
          "ownerId": {
            "type": "string",
            "format": "uuid"
          },
          "notes": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 0
          }
        },
        "required": [
          "agencyId",
          "materialType",
          "object",
          "totalValue"
        ]
      },
      "UpdateTenderRequest": {
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "tender": {
            "$ref": "#/components/schemas/TenderRequest"
          }
        },
        "required": [
          "tender",
          "version"
        ]
      },
      "AgencyRefResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
