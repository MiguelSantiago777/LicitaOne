                    "$ref": "#/components/schemas/UserOptionResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tenders/{id}/history": {
      "get": {
        "tags": [
          "tenders"
        ],
        "summary": "Histórico de alterações",
        "operationId": "tenderHistory",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
