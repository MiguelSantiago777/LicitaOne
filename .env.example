# Copie para .env e ajuste. Nunca commite o .env.
COMPOSE_PROJECT_NAME=shemacrm

# Portas expostas no host (os padrões evitam conflito com outros projetos locais)
POSTGRES_PORT=15432
RABBITMQ_PORT=15682
RABBITMQ_UI_PORT=15683
S3_PORT=18333
MAILPIT_SMTP_PORT=11025
MAILPIT_UI_PORT=18025
BACKEND_PORT=18080
FRONTEND_PORT=14200
PROMETHEUS_PORT=19090
GRAFANA_PORT=13000

# Banco
POSTGRES_DB=shemacrm
POSTGRES_USER=shemacrm
POSTGRES_PASSWORD=troque-esta-senha

# Mensageria
RABBITMQ_USER=shemacrm
RABBITMQ_PASSWORD=troque-esta-senha

# Armazenamento S3 (SeaweedFS no dev)
S3_ACCESS_KEY=shemacrm
S3_SECRET_KEY=troque-esta-chave

# Primeiro administrador, criado na subida se não houver usuários
SHEMA_ADMIN_EMAIL=admin@shema.local
SHEMA_ADMIN_PASSWORD=troque-esta-senha-admin

# Chave de assinatura dos JWT (PEM PKCS#8, RSA 2048+). Em branco = gera uma chave
# temporária na subida (só serve para dev: todos os tokens caem quando o backend reinicia).
SHEMA_JWT_PRIVATE_KEY=
SHEMA_JWT_KEY_ID=dev-1

# Porta do Actuator quando o backend roda fora do container
MANAGEMENT_PORT=18081
