# Copie para .env e ajuste. Nunca commite o .env.
COMPOSE_PROJECT_NAME=shemacrm

# Portas expostas no host (os padrões evitam conflito com outros projetos locais)
POSTGRES_PORT=15432
RABBITMQ_PORT=15682
RABBITMQ_UI_PORT=15683
S3_PORT=18333
MAILPIT_SMTP_PORT=11025
MAILPIT_UI_PORT=18025
BACKEND_PORT=18080
FRONTEND_PORT=14200
PROMETHEUS_PORT=19090
GRAFANA_PORT=13000

# Banco
POSTGRES_DB=shemacrm
POSTGRES_USER=shemacrm
POSTGRES_PASSWORD=troque-esta-senha

# Mensageria
RABBITMQ_USER=shemacrm
RABBITMQ_PASSWORD=troque-esta-senha

# Armazenamento S3 (SeaweedFS no dev)
S3_ACCESS_KEY=shemacrm
S3_SECRET_KEY=troque-esta-chave

# Primeiro administrador, criado na subida se não houver usuários
SHEMA_ADMIN_EMAIL=admin@shema.local
SHEMA_ADMIN_PASSWORD=troque-esta-senha-admin

# Chave de assinatura dos JWT (PEM PKCS#8, RSA 2048+). Em branco = gera uma chave
# temporária na subida (só serve para dev: todos os tokens caem quando o backend reinicia).
SHEMA_JWT_PRIVATE_KEY=
SHEMA_JWT_KEY_ID=dev-1

# Leitura de atas e contratos com IA (ADR 0016). Em branco = funcionalidade desligada (o botão não aparece).
# Os PDFs só vão para a API da Anthropic quando alguém clica em "Preencher com IA".
ANTHROPIC_API_KEY=
# SHEMA_EXTRACTION_MODEL=claude-opus-5-5

# Provedor da IA (ADR 0021): claude (ANTHROPIC_API_KEY, pago por uso) ou gemini (GEMINI_API_KEY, chave do
# Google AI Studio; tem plano gratuito com limite diário). No plano gratuito do Gemini o Google pode usar o conteúdo
# enviado para melhorar os produtos dele: confirme com o cliente antes de ligar em produção.
# SHEMA_AI_PROVIDER=gemini
# GEMINI_API_KEY=
# SHEMA_EXTRACTION_GEMINI_MODEL=gemini-3.8-flash
# SHEMA_ASSISTANT_GEMINI_MODEL=gemini-3.8-flash

# "Pergunte ao LicitaOne" (ADR 0020): usa a mesma ANTHROPIC_API_KEY. Perguntas por pessoa por dia
# (o E2E pergunta várias vezes: use 1000 ao rodá-lo).
# SHEMA_ASSISTANT_DAILY_LIMIT=50

# Dados da empresa no kit de carona (Fase 10): cabeçalho das cartas e ofício de anuência. Exemplos: troque no deploy.
SHEMA_COMPANY_LEGAL_NAME=Shema Suprimentos e Serviços
SHEMA_COMPANY_CNPJ=00.000.000/0001-00
SHEMA_COMPANY_ADDRESS=Rua Exemplo, 100, Centro, Cidade/UF, CEP 00000-000
SHEMA_COMPANY_CITY=Cidade/UF
SHEMA_COMPANY_REPRESENTATIVE=Nome do representante legal
SHEMA_COMPANY_REPRESENTATIVE_ROLE=Sócio-administrador
SHEMA_COMPANY_EMAIL=comercial@exemplo.com.br
SHEMA_COMPANY_PHONE=(00) 0000-0000

# Alertas (ADR 0015). Prazos em dias; o da licitação vencida sem contrato precisa de validação do cliente.
# SHEMA_ALERTS_CRON=0 0 7 * * *
# SHEMA_ALERTS_CONTRACT_WITHOUT_ORDER_DAYS=30
# SHEMA_ALERTS_PRICE_RECORD_EXPIRING_DAYS=90,60,30
# SHEMA_ALERTS_TENDER_WITHOUT_CONTRACT_DAYS=30
# Aviso interno por e-mail: no compose vai para o Mailpit. Em produção, aponte MAIL_HOST/PORT/USER/PASSWORD.
# SHEMA_ALERTS_MAIL_ENABLED=true
# SHEMA_ALERTS_MAIL_FROM=LicitaOne <alertas@shema.local>

# Porta do Actuator quando o backend roda fora do container
MANAGEMENT_PORT=18081

# Tentativas de login por minuto por IP (o E2E entra muitas vezes seguidas: use 300 ao rodá-lo)
SHEMA_LOGIN_ATTEMPTS_PER_MINUTE=10
