# Produção. O jeito fácil é gerar este arquivo com o script, que cria as senhas e a chave JWT:
#   deploy/setup/gerar-env-prod.sh
# À mão: copie para .env.prod, preencha, rode `chmod 600 .env.prod` e `ln -s .env.prod .env`.
# Com o link, o `docker compose` (e os scripts de backup) já leem este arquivo e os dois compose abaixo:
#   docker compose up -d --build --wait
# Valores com espaço vão entre aspas (o backup.sh lê este arquivo com o bash).
COMPOSE_PROJECT_NAME=licitaone
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# Endereço público (HTTPS, no proxy da frente). Vira a origem do CORS e o link dos e-mails.
SHEMA_PUBLIC_URL=https://licitaone.exemplo.com.br
FRONTEND_PORT=14200

# Banco e mensageria: senhas longas e aleatórias (ex.: openssl rand -hex 24)
POSTGRES_DB=shemacrm
POSTGRES_USER=shemacrm
POSTGRES_PASSWORD=
RABBITMQ_USER=shemacrm
RABBITMQ_PASSWORD=

# Arquivos: SeaweedFS local (padrão) ou provedor S3 externo (descomente S3_ENDPOINT)
S3_ACCESS_KEY=shemacrm
S3_SECRET_KEY=
# S3_ENDPOINT=https://s3.sa-east-1.amazonaws.com
# S3_REGION=sa-east-1
# S3_BUCKET=licitaone-arquivos

# Usuário master: crie com deploy/setup/criar-admin.sh depois de subir (como o createsuperuser do Django).
# Opcional: preenchido aqui, o backend cria esse administrador na subida, só se ainda não houver nenhum.
SHEMA_ADMIN_NAME=Administrador
SHEMA_ADMIN_EMAIL=
SHEMA_ADMIN_PASSWORD=

# Chave de assinatura dos tokens (obrigatória em produção). Gere com:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
# e cole o PEM entre aspas duplas, com as quebras de linha. Ao trocar a chave, mude também o KEY_ID.
SHEMA_JWT_PRIVATE_KEY=
SHEMA_JWT_KEY_ID=prod-2026-11

# Leitura de atas e contratos com IA (ADR 0016). Em branco = funcionalidade desligada (o botão não aparece).
# Os PDFs só vão para a API da Anthropic quando alguém clica em "Preencher com IA".
ANTHROPIC_API_KEY=
# SHEMA_EXTRACTION_MODEL=claude-opus-5-5

# Provedor da IA (ADR 0021): claude (ANTHROPIC_API_KEY, pago por uso) ou gemini (GEMINI_API_KEY, chave do
# Google AI Studio; tem plano gratuito com limite diário). No plano gratuito do Gemini o Google pode usar o conteúdo
# enviado para melhorar os produtos dele: confirme com o cliente antes de ligar em produção.
SHEMA_AI_PROVIDER=claude
GEMINI_API_KEY=
# SHEMA_EXTRACTION_GEMINI_MODEL=gemini-3.8-flash
# SHEMA_ASSISTANT_GEMINI_MODEL=gemini-3.8-flash
# Perguntas ao assistente por pessoa por dia (ADR 0020)
# SHEMA_ASSISTANT_DAILY_LIMIT=50
SHEMA_LOGIN_ATTEMPTS_PER_MINUTE=10

# Dados da empresa nas cartas do kit de carona (ADR 0019). Campo em branco aparece entre colchetes nas cartas.
SHEMA_COMPANY_LEGAL_NAME="Shema Suprimentos e Serviços"
SHEMA_COMPANY_CNPJ=
SHEMA_COMPANY_ADDRESS=
SHEMA_COMPANY_CITY=
SHEMA_COMPANY_REPRESENTATIVE=
SHEMA_COMPANY_REPRESENTATIVE_ROLE=
SHEMA_COMPANY_EMAIL=
SHEMA_COMPANY_PHONE=

# SMTP dos avisos internos (ADR 0006): porta 587 com STARTTLS
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_STARTTLS=true
SHEMA_ALERTS_MAIL_FROM="LicitaOne <alertas@exemplo.com.br>"
# SHEMA_ALERTS_TENDER_WITHOUT_CONTRACT_DAYS=30
